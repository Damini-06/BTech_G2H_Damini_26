#include <stdio.h>
#include <math.h>
int main() {
	int p,r,t,product,SI,CI,TI;
	printf("Enter the principal amount: \n");
	scanf("%d", &p);
	printf("Enter the rate of interest per annum:\n");
	scanf("%d", &r);
	printf("Enter the time:\n");
	scanf("%d", &t);
	product=p*r*t;
	SI = product/100;
	printf("The simple interest is: %d \n",SI);
	CI=p*pow((1+(r/100.0)),t)-p;
	printf("The Compound Interest is: %d", CI);
	    return 0;
	    
}

