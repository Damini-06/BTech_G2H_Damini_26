#include <stdio.h>

int main() {
    int n;
    printf("Enter size of matrix:\n");
    scanf("%d",&n);
    
    int a[n][n];
    int b[n][n];
    printf("Enter elements of 1st array:\n");
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            scanf("%d",&a[i][j]);
        }
    }
    
    printf("Enter elements of 2nd array:\n");
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            scanf("%d",&b[i][j]);
        }
    }
     printf("Product Array is:\n");
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            int x=0;
            for(int k=0;k<n;k++)
            {
                x+=a[i][k]*b[k][j];
            }
            printf(" %d ",x);
        }
        printf("\n");
    }
    
}

