#include <stdio.h>
int gcd(int a,int b)
{
    if(a==0) return b;
    return gcd(b%a,a);
}
int main() {
	int a,b;
	printf("Enter two numbers:\n");
	scanf("%d %d",&a,&b);
	int GCD = gcd(a,b);
	int LCM = (a*b)/GCD;
	printf("GCD of %d and %d is:%d \n",a,b,GCD);
	printf("LCM of %d and %d is:%d",a,b,LCM);
}

