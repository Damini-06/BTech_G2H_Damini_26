#include <stdio.h>

int main() {
    int r,c,sumd1,sumd2;
	printf("Enter no. of rows and columns:\n");
	scanf("%d %d",&r,&c);
	int a[r][c];
	
	printf("Enter elements of matrix:\n");
	for(int i=0;i<r;i++)
	{
	    for(int j=0;j<c;j++)
	    {
	        scanf("%d",&a[i][j]);
	    }
	}
	
	int j=c-1;
    for(int i=0;i<r;i++)
    {
        sumd1+=a[i][i];
        sumd2+=a[i][j];
        j--;
    }
    printf("Sum of left diagonal is: %d \nSum of right diagonal is: %d",sumd1,sumd2);
}

