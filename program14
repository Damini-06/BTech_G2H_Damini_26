#include <stdio.h>

int main() {
    int n;
    printf("Enter the size of array:\n");
    scanf("%d",&n);
    int a[n];
    printf("Enter elements of array:\n");
    scanf("%d",&a[0]);
    int max=a[0];
    for(int i=1;i<n;i++)
    {
        scanf("%d",&a[i]);
        if(a[i]>max) max=a[i];
    }

    printf("Largest of all elements: %d",max);
   
    
}

