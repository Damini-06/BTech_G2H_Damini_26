#include <stdio.h>

int main() {
    int n; int even=0;int odd=0;
    printf("Enter the size of array:\n");
    scanf("%d",&n);
    int a[n];
    printf("Enter elements of array:\n");
    for(int i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
        if(a[i]%2==0) even++;
        else odd++;
    }
    
    printf("Number of even and odd elements are: %d and %d",even,odd);
    
}

