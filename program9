#include <stdio.h>
#include <ctype.h>
int main() {
    int a,b,c;
	printf("Enter three sides:\n");
	scanf("%d %d %d",&a,&b,&c);
	if(a+b>c || b+c>a || a+c>b)
	{
	    printf("Valid\n");
	    if((a==b && b!=c) || (a==c && c!=b)|| (b==c && a!=c ))
	    {
	        printf("Isosceles");
	    }
	    else if(a==b && b==c)
	    {
	        printf("Equilateral");
	    }
	    else
	    {
	        printf("Scalene");
	    }
	}
}

